{
  "policy": {
    "_meta": {
      "description": "MiniShop log retention: roll over daily, delete 3 days after rollover (ADR 0017)",
      "managed_by": "scripts/deploy-logging.sh"
    },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_primary_shard_size": "1gb"
          }
        }
      },
      "delete": {
        "min_age": "3d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
