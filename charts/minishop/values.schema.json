{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "replicas", "resources", "credentials"],
  "properties": {
    "images": {
      "type": "object",
      "required": ["postgresql", "redis", "backend", "frontend"],
      "properties": {
        "postgresql": { "$ref": "#/definitions/digestImage" },
        "redis": { "$ref": "#/definitions/digestImage" },
        "backend": { "$ref": "#/definitions/digestImage" },
        "frontend": { "$ref": "#/definitions/digestImage" }
      },
      "additionalProperties": false
    },
    "replicas": {
      "type": "object",
      "required": ["postgresql", "redis", "backend", "frontend"],
      "properties": {
        "postgresql": { "type": "integer", "minimum": 1 },
        "redis": { "type": "integer", "minimum": 1 },
        "backend": { "type": "integer", "minimum": 1 },
        "frontend": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["postgresql", "redis", "backend", "frontend"],
      "properties": {
        "postgresql": { "$ref": "#/definitions/resources" },
        "redis": { "$ref": "#/definitions/resources" },
        "backend": { "$ref": "#/definitions/resources" },
        "frontend": { "$ref": "#/definitions/resources" }
      },
      "additionalProperties": false
    },
    "credentials": {
      "type": "object",
      "required": ["dataSecretName", "appSecretName"],
      "properties": {
        "dataSecretName": { "type": "string", "minLength": 1 },
        "appSecretName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "digestImage": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string", "minLength": 1 },
            "memory": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string", "minLength": 1 },
            "memory": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
